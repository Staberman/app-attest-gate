{
  "name": "app-attest-gate",
  "version": "1.0.0",
  "description": "The parts of Apple App Attest everyone hand-rolls wrong: single-use challenges, atomic replay protection, per-assertion environment pinning, request-body binding — plus StoreKit 2 entitlements and a server-metered free tier.",
  "keywords": [
    "app-attest",
    "appattest",
    "devicecheck",
    "ios",
    "apple",
    "storekit",
    "entitlement",
    "replay-protection",
    "rate-limit",
    "attestation"
  ],
  "license": "MIT",
  "author": "Lautaro Antunez <lautaro@staberman.com.ar>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Staberman/app-attest-gate.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-app-attest": "^1.0.1"
  },
  "peerDependencies": {
    "@apple/app-store-server-library": ">=1.4.0"
  },
  "peerDependenciesMeta": {
    "@apple/app-store-server-library": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
